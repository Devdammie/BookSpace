# Pooled Neon connection used by the API at runtime.
# Must include sslmode=require. The host should contain "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct Neon connection used only by migrations (session advisory locks).
# Same database, host without "-pooler".
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

SESSION_SECRET=replace-with-a-long-random-string
WEB_ORIGIN=http://localhost:5173
# Optional comma-separated extra origins (preview apps, custom domains).
# WEB_ORIGINS=https://bookspace.vercel.app,https://staging.example.com
DEPARTMENT_TIMEZONE=America/Los_Angeles
PORT=4000
NODE_ENV=development

# Set to true only when the API process also serves apps/web/dist (e.g. Render single service).
# On Vercel leave false — the Vite service serves the SPA.
SERVE_WEB=false

# Required on Vercel for the minute maintenance cron (Authorization: Bearer …).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Force the in-process minute job on/off. Default: on locally/Render, off on Vercel.
# ENABLE_IN_PROCESS_SCHEDULER=false
