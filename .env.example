# Pooled Neon connection used by the API at runtime.
# Must include sslmode=require. The host should contain "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct Neon connection used only by migrations (session advisory locks).
# Same database, host without "-pooler".
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

SESSION_SECRET=replace-with-a-long-random-string
WEB_ORIGIN=http://localhost:5173
DEPARTMENT_TIMEZONE=America/Los_Angeles
PORT=4000
NODE_ENV=development

# Set to true in production to serve apps/web/dist from the API process.
SERVE_WEB=false
